# Taille maximale par fichier en octets (défaut: 32768 = 32 Ko)
TUTOR_MAX_FILE_BYTES="32768"

# Taille maximale de la question de l'étudiant en caractères (défaut: 2000)
TUTOR_MAX_QUESTION_LENGTH="2000"

# Limite de requêtes par minute sur les routes d'analyse/compilation Studio par IP (défaut: 10)
STUDIO_RATE_LIMIT_PER_MINUTE="10"
